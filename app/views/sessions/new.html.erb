<div class="login-card">
  <div class="icon">🔐</div>
  <h1>Iniciar sesión</h1>
  <p class="muted">Ingresa para acceder al panel</p>

  <%= form_with url: login_path, method: :post, class: "form" do |f| %>
    <div class="form-group">
      <%= f.label :username, "Usuario" %>
      <%= f.text_field :username, autofocus: true, placeholder: "admin" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Contraseña" %>
      <%= f.password_field :password, placeholder: "••••••••" %>
    </div>

    <%= f.submit "Entrar", class: "btn btn-primary btn-block" %>
  <% end %>
</div>